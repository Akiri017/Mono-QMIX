<configuration>
  <input>
    <net-file value="../../../bgc_full/final_map.net.xml"/>
    <!-- Med demand: wardrop_routes_med.rou.xml (~1800 veh/hr, period=2.0s) -->
    <route-files value="controlled_init.rou.xml,../../../bgc_full/wardrop_routes_med.rou.xml"/>
    <additional-files value="../../../bgc_full/vtypes.add.xml,../../../bgc_full/osm.poly.xml"/>
  </input>

  <processing>
    <time-to-teleport value="300"/>
    <ignore-junction-blocker value="1"/>
  </processing>

  <time>
    <begin value="0"/>
    <end value="3600"/>
    <step-length value="1.0"/>
  </time>
</configuration>
